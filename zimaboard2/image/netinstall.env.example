# TrailCurrent Peregrine (ZimaBoard 2) — netinstall.sh local settings
#
# Copy to netinstall.env (gitignored) or let netinstall.sh write it when it
# asks. The board can also be given on the command line or in the
# environment variable of the same name.

# SSH login on the board's CURRENT operating system (the one being replaced),
# as user@host. The user needs root or sudo.
PEREGRINE_NETINSTALL_TARGET=user@board-hostname-or-address
