# TrailCurrent Peregrine — ZimaBoard 2 build pins
#
# Every artefact the image pulls from outside the Ubuntu archive is pinned
# here by version and SHA-256. preflight.sh refuses anything that does not
# match. Bump a pin by editing this file, never by editing a build script.

# Ubuntu suite for both the installed system and the live installer
SUITE=noble
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu

# llama.cpp — built from source (Vulkan + CPU backends) by build-llama.sh
LLAMA_TAG=b11700
LLAMA_COMMIT=23f7aabc16c72f6f707dba227251c35d7bd1ed96
LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git

# Baked-in LLM. Llama-3.2-3B-Instruct: the 3B sibling of the Q6A's Llama 3.2
# 1B, under the same licence the Q6A image already ships. Chosen by the
# maintainer over Phi-4-mini (MIT, 3.8B), which measured 8.3 tok/s against
# 9.3 on the CPU lane (docs/benchmarks.md).
LLM_MODEL_NAME=Llama-3.2-3B-Instruct-Q4_K_M
LLM_MODEL_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLM_MODEL_URL=https://huggingface.co/bartowski/Llama-3.2-3B-Instruct-GGUF/resolve/5ab33fa94d1d04e903623ae72c95d1696f09f9e8/Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLM_MODEL_SHA256=6c1a2b41161032677be168d354123594c0e6e67d2b9227c84f296ad037c728ff
LLM_MODEL_LICENSE=Llama-3.2

# faster-whisper base.en (MIT), baked into the HF cache so HF_HUB_OFFLINE=1 works
WHISPER_REPO=Systran/faster-whisper-base.en
WHISPER_REVISION=3d3d5dee26484f91867d81cb899cfcf72b96be6c

# Piper voice (CC-BY-4.0) — same files as the Q6A image
PIPER_VOICE=en_US-libritts_r-medium
PIPER_BASE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/5041a7a49ae5b3a0f30e6837769eb03fdbb231bd/en/en_US/libritts_r/medium
PIPER_ONNX_SHA256=10bb85e071d616fcf4071f369f1799d0491492ab3c5d552ec19fb548fac13195
PIPER_JSON_SHA256=b471dc60d2d8335e819c393d196d6fbf792817f40051257b269878505bc9afb3

# kexec-tools — static kexec that netinstall.sh runs on the board's current OS
KEXEC_VERSION=2.0.32
KEXEC_URL=https://mirrors.edge.kernel.org/pub/linux/utils/kernel/kexec/kexec-tools-2.0.32.tar.xz
KEXEC_SHA256=8f81422a5fd2362cf6cb001b511e535565ed0f32c2f4451fb5eb68fed6710a5d

# Builder container (pinned by digest so two builds use the same toolchain)
BUILDER_IMAGE=ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c
