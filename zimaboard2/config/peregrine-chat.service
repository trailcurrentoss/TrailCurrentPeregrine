[Unit]
Description=Peregrine Web Chat (LAN-facing UI for the on-device LLM)
After=network-online.target peregrine-llm-bridge.service
Wants=network-online.target peregrine-llm-bridge.service

[Service]
Type=simple
User=trailcurrent
Group=trailcurrent
WorkingDirectory=/home/trailcurrent
# Uses the same venv as voice-assistant.service — faster-whisper + piper
# live there, and the /api/voice endpoint imports both.
ExecStart=/home/trailcurrent/assistant-env/bin/python3 /home/trailcurrent/web_chat.py
Restart=on-failure
RestartSec=3

Environment=PYTHONUNBUFFERED=1
Environment=WEB_CHAT_HOST=0.0.0.0
Environment=WEB_CHAT_HTTPS_PORT=443
Environment=WEB_CHAT_HTTP_PORT=80
Environment=WEB_CHAT_PUBLIC_HOSTNAME=peregrine.local
Environment=WEB_CHAT_TLS_CERT=/home/trailcurrent/certs/server.crt
Environment=WEB_CHAT_TLS_KEY=/home/trailcurrent/certs/server.key
Environment=WEB_CHAT_CA_PATH=/home/trailcurrent/certs/ca.pem
# The LLM bridge serves the same API genie-server does on the Q6A.
Environment=GENIE_URL=http://127.0.0.1:11434
# 8K context per llama-server slot (the Q6A default is 700 for Genie's 1K).
Environment=WEB_CHAT_MAX_CONTEXT=7000
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1

# --- ESP32 P4 push-to-talk terminal (POST /api/voice on VOICE_PORT) ---
# Bearer token is required; when unset the endpoint stays closed. Generate
# with: openssl rand -hex 32   (then bake into the ESP32 NVS on setup).
Environment=PEREGRINE_VOICE_PORT=8081
Environment=PEREGRINE_VOICE_TOKEN=
Environment=PEREGRINE_VOICE_MAX_BYTES=1048576
Environment=PEREGRINE_VOICE_TARGET_SR=16000
Environment=PIPER_MODEL=/home/trailcurrent/piper-voices/en_US-libritts_r-medium.onnx
Environment=WHISPER_SIZE=base.en
Environment=CPU_THREADS=3

AllowedCPUs=0-2
CPUWeight=200
MemoryHigh=768M

# Allow binding privileged ports 80 + 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
