# TrailCurrent Peregrine (ZimaBoard 2) — /etc/peregrine/llm.env
#
# Read by peregrine-llm.service (llama-server) and peregrine-llm-bridge.service.
# Written by `peregrine-model set <name>`; edit by hand only if you know why,
# then: sudo systemctl restart peregrine-llm

# Active GGUF. Models live in /var/lib/peregrine/llm/models/.
LLM_MODEL=/var/lib/peregrine/llm/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf

# Total context, split evenly across slots. One 8K slot: GPU buffers ARE
# charged to the peregrine-llm cgroup (measured on the board: weights + two
# 8K q8_0 KV caches + compute buffers pinned it at MemoryMax=4.5G and
# throttled prompt processing ~10x). Two slots (LLM_CTX_TOTAL=16384,
# LLM_SLOTS=2) keep voice and web-chat prompts cached side by side, but
# need MemoryMax raised in a drop-in.
LLM_CTX_TOTAL=8192
LLM_SLOTS=1

# Backend. Default: the CPU lane (plan §6.1 fallback c) — three threads on
# cores 1-3 (AllowedCPUs in the unit), core 0 kept for the voice loop, the
# yield gate on. LLM_DEVICE=none keeps llama.cpp off the GPU entirely: on the
# noble HWE kernel, i915 times out llama.cpp's Vulkan work ("Fence
# expiration time out" every 20 s), so the iGPU is slower than the CPU until
# that is fixed (plan §6.1 fallback b: the xe driver). See docs/benchmarks.md.
# iGPU lane, for when it works: LLM_DEVICE=Vulkan0 LLM_NGL=99 LLM_THREADS=1
LLM_DEVICE=none
LLM_NGL=0
LLM_THREADS=3

# Per-model extras, copied from <model>.args by peregrine-model. Example for
# hybrid Qwen3 (disables thinking). Single quotes keep the inner double
# quotes intact through systemd's EnvironmentFile parser:
#   LLM_EXTRA_ARGS='--chat-template-kwargs {"enable_thinking":false}'
LLM_EXTRA_ARGS=

# Bridge: tokens for clients that do not send num_predict (web chat).
LLM_DEFAULT_MAX_TOKENS=512
